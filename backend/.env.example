APHRODITE_ENV=development
APHRODITE_HTTP_HOST=127.0.0.1
APHRODITE_HTTP_PORT=8080
APHRODITE_READ_TIMEOUT=10s
APHRODITE_WRITE_TIMEOUT=15s
APHRODITE_IDLE_TIMEOUT=60s
APHRODITE_SHUTDOWN_TIMEOUT=10s
APHRODITE_DATABASE_URL=postgres://aphrodite:replace-me@127.0.0.1:5432/aphrodite?sslmode=disable
APHRODITE_ACCESS_TOKEN_PRIVATE_KEY=replace-with-base64-ed25519-private-key
