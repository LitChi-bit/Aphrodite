# Auto detect text files and perform LF normalization.
* text=auto

# Cross-platform source and configuration files use LF.
*.dart text eol=lf
*.go text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# Windows command scripts retain their native line ending.
*.bat text eol=crlf
*.cmd text eol=crlf
